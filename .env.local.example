# Stellar Fund Configuration
# Copy this file to .env.local and fill in the values

# Supabase Configuration (for shared campaign data)
# Get these from https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contract ID (after deploying via scripts/deploy.sh)
NEXT_PUBLIC_CONTRACT_ID=

# Network: testnet | mainnet
NEXT_PUBLIC_NETWORK=testnet

# Deployer wallet address (from stellar keys list)
NEXT_PUBLIC_DEPLOYER=

# Google Form URL for user onboarding (create at forms.google.com)
NEXT_PUBLIC_GOOGLE_FORM_URL=
